{
  "name": "mushpi-server",
  "version": "0.8.0",
  "description": "A backend for the Mushroom Pi project",
  "author": "amda-phd",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "audit:ci": "yarn audit:prod; [[ $? -ge 8 ]] && (echo 'Serious vulnerabilities found!' && exit 1) || exit 0",
    "audit:prod": "yarn npm audit --environment production",
    "build": "nest build",
    "docs:env": "ts-node docs/env-vars.generator.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "knip:ci": "knip --dependencies --exclude devDependencies",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:generate": "yarn build && yarn typeorm migration:generate",
    "migration:run": "yarn build && yarn typeorm migration:run",
    "migration:revert": "yarn build && yarn typeorm migration:revert",
    "migration:show": "yarn build && yarn typeorm migration:show",
    "test": "jest --reporters default",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:cov": "jest --config ./test/jest-e2e.json --coverage",
    "typeorm": "node ./node_modules/typeorm/cli.js -d dist/src/modules/sqlite/data-source.js",
    "spec:export": "ts-node -r tsconfig-paths/register spec/generators/openapi.generator.ts",
    "spec:bruno": "ts-node -r tsconfig-paths/register spec/generators/bruno.generator.ts",
    "spec:all": "yarn spec:export && yarn spec:bruno",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.12.2",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.21",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.0.1",
    "nestjs-pino": "^4.4.1",
    "pino": "^9.2.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "toobusy-js": "^0.5.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@types/toobusy-js": "^0.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "js-yaml": "^5.2.1",
    "knip": "^5.51.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.45.0"
  },
  "resolutions": {
    "multer": "2.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "reporters": [
      [
        "github-actions",
        {
          "silent": false
        }
      ],
      "summary"
    ]
  }
}
