# Make the code as readable as possible
yarn format
yarn lint

# Check if config.schema.ts changed
if git diff --cached --name-only | grep -q 'src/modules/config/config.schema.ts'; then
  echo "🔄 Config schema changed - regenerating ENVIRONMENT.md"
  
  # Run documentation generator (assuming it's in docs/env-vars.generator.ts)
  yarn docs:env
  
  # Add the generated file to commit
  git add docs/ENVIRONMENT.md
  echo "✅ Updated ENVIRONMENT.md added to commit"
else
  echo "⏩ No changes to config schema - skipping documentation update"
fi

# Regenerate OpenAPI spec + Bruno collection when source changes
if git diff --cached --name-only | grep -qE '^src/'; then
  echo "🔄 src/ changed - regenerating OpenAPI spec and Bruno collection"
  yarn spec:all
  git add spec/openapi.json spec/openapi.yaml
  echo "✅ Refreshed spec files staged"
else
  echo "⏩ No src/ changes - skipping spec regeneration"
fi

# Finally, check build integrity
yarn build