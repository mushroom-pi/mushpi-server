# mushpi-server environment template — copy to `.env` and adjust.
#
# This file documents the full environment surface. The generated reference
# (`docs/ENVIRONMENT.md`, via `yarn docs:env`) is canonical for validation
# rules and descriptions; keep this template aligned with the schema in
# `src/modules/config/config.schema.ts`.
#
# Unknown keys are tolerated at boot (never fatal), so stale leftovers in a
# deployed `.env` are ignored rather than breaking startup.

# ── Core ────────────────────────────────────────────────────────────
# local | dev | staging | prod | test | demo  (default: local)
NODE_ENV=local
# Listen port (default 3000; legacy `PORT` is accepted as a fallback).
APP_PORT=3000

# ── SQLite ──────────────────────────────────────────────────────────
SQLITE_PATH=./data/app.sqlite
SQLITE_LOG=false

# ── Client / SPA serving ────────────────────────────────────────────
# CORS allowed origin. Required when NODE_ENV=local; optional elsewhere.
# CLIENT_URL=http://localhost:5173
# Built mushpi-client `dist/` directory to serve as SPA. Required when
# NODE_ENV=prod; unset disables SPA serving (dev uses Vite :5173).
# CLIENT_DIST_DIR=/usr/src/app/client

# ── Swagger docs ────────────────────────────────────────────────────
# Swagger UI path (default `contract` in local). Unset or empty disables
# the UI and its `-json` OpenAPI document route.
# DOCS_ENDPOINT=contract
# Extra CORS origin for the Swagger UI when docs are enabled.
# DOCS_UI_URL=
# Basic-auth pair for the docs surface — optional in every environment;
# a non-empty username requires a matching password.
# DOCS_USERNAME=
# DOCS_PASSWORD=

# ── Logging / errors ────────────────────────────────────────────────
# Pino level: fatal | error | warn | info | debug | trace (default: info)
LOGS_LEVEL=info
LOGS_PATH=./data/logs
LOGS_LIFE_DAYS=7
# Append timestamp/path/emitter to error bodies. On unless literally `false`.
ERRORS_DETAIL=true

# ── Security ────────────────────────────────────────────────────────
# Optional Bearer token for human auth (LAN/Tailscale is the security
# boundary). A demo deployment leaves it unset — setting it would 426 the
# dashboard.
# APP_SECRET=
# Declares the browser-facing deployment is HTTPS (TLS terminated upstream/
# directly; configures no TLS itself). Gates helmet HSTS + CSP
# upgrade-insecure-requests. Keep `false` on plain-HTTP LAN deployments.
APP_HTTPS_ENABLED=false
# toobusy-js overload-rejection threshold in ms (default 100).
MAX_EVENT_LOOP_DELAY=100

# ── Pico units ──────────────────────────────────────────────────────
# Shared secret for POST /v1/pico-units/announce (min 6 chars).
# Required in prod and demo; in demo the public development value
# `mushpi-dev-secret` is rejected at boot. Elsewhere it defaults to that
# development value.
# PICO_ANNOUNCE_SECRET=mushpi-dev-secret

# ── Readings retention ──────────────────────────────────────────────
# Months of readings to retain before the nightly cleanup (default 6).
READINGS_RETENTION_MONTHS=6

# ── Demo seeding (server-owned) ─────────────────────────────────────
# Insert-only catalogue/roster/history seeding. Capability-named key; the
# profile scope lives in the schema: ON by default in NODE_ENV=demo, OFF
# elsewhere. Set explicitly to force either state — EXCEPT on prod, where
# seeding is ALWAYS refused regardless of this flag (warn + no-op).
# SEED_ENABLED=false
# Days of backdated 60 s readings history generated per live unit.
# SEED_READINGS_DAYS=14

# ── Rate limiting — SELF-HOSTED profile (opt-in) ────────────────────
# All-or-nothing pair: set BOTH or NEITHER. A partial pair fails at boot.
# Neither set ⇒ no throttling and no X-RateLimit-* headers at all.
# IGNORED when NODE_ENV=demo (the public-demo profile below always arms its
# own three limiter pairs). Window is MILLISECONDS; the emitted
# X-RateLimit-Reset / Retry-After headers are relative SECONDS.
# MAX_REQUESTS=
# MAX_REQUESTS_TIME=

# ── Rate limiting — PUBLIC-DEMO profile (required when NODE_ENV=demo) ─
# These six values are REQUIRED when `NODE_ENV=demo` — a demo boot missing
# any of them fails at startup rather than serving an unprotected instance.
# On every other profile they are optional and read by no throttler
# definition (scope is carried by the required-when-demo rule). Each pair
# is all-or-nothing; windows are MILLISECONDS. The limit values below are
# the recommended demo deployment values.
VISITOR_MAX_REQUESTS=300
VISITOR_MAX_REQUESTS_TIME=60000
ABUSE_MAX_REQUESTS=30
ABUSE_MAX_REQUESTS_TIME=60000
GLOBAL_MAX_REQUESTS=3000
GLOBAL_MAX_REQUESTS_TIME=60000

# ── Uploads ─────────────────────────────────────────────────────────
# Base directory for uploaded images (served under /images).
UPLOAD_DIR=./data
