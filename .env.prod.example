# Copy this file to .env.prod and fill in the values before running docker compose up

PORT=3000
APP_HOST=http://127.0.0.1

# URL of the frontend client (used for CORS). Optional in prod — only required in local dev.
# CLIENT_URL=http://raspberrypi.local:5173

# Bearer token for API authentication (min 6 chars, required in prod)
APP_SECRET=change-me

# Shared secret required in the X-Pico-Secret header for POST /pico-units/announce (Pico boot announcements)
PICO_ANNOUNCE_SECRET=change-me

# Log level: info (default) | debug | warn | error
LOGS_LEVEL=info

# Logs life in days (7 by default)
LOGS_LIFE_DAYS=10

# Upload directory for images (defaults to 'data'; set to '/data' in Docker)
# UPLOAD_DIR=/data

# Swagger docs — leave DOCS_ENDPOINT blank to disable in production
# DOCS_ENDPOINT=contract
# DOCS_USERNAME=your-username
# DOCS_PASSWORD=your-password

# Absolute path to the built React client (dist/) to serve as a single-container SPA.
# Required in prod. Leave unset in local dev (client runs on Vite :5173).
# In Docker, set to the path where the image copies the client build output.
CLIENT_DIST_DIR=/usr/src/app/client
