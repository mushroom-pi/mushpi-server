# Copy this file to .env.prod and fill in the values before running docker compose up

PORT=3000
APP_HOST=http://127.0.0.1

# URL of the frontend client (used for CORS)
CLIENT_URL=http://raspberrypi.local:5173

# Bearer token for API authentication (min 6 chars, required in prod)
APP_SECRET=change-me

# Log level: info (default) | debug | warn | error
LOGS_LEVEL=info

# Logs life in days (7 by default)
LOGS_LIFE_DAYS=10

# Swagger docs — leave DOCS_ENDPOINT blank to disable in production
# DOCS_ENDPOINT=contract
# DOCS_USERNAME=your-username
# DOCS_PASSWORD=your-password
